{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/auto-buffer",
      "schedule": "5 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/share/(.*)",
      "destination": "/frontend/share.html"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
